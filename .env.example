# SQL Vault - Ambiente de Desenvolvimento
# Copie este arquivo para .env e preencha os valores.

# PostgreSQL local
POSTGRES_USER="sqlvault"
POSTGRES_PASSWORD="sqlvault"
POSTGRES_DB="sqlvault"
POSTGRES_PORT="5432"

# Aplicação executada diretamente no host
DATABASE_URL="postgresql://sqlvault:sqlvault@localhost:5432/sqlvault?schema=public"

# Aplicação executada pelo Docker Compose (host interno = db)
DOCKER_DATABASE_URL="postgresql://sqlvault:sqlvault@db:5432/sqlvault?schema=public"

# Secret do NextAuth. Gere um novo com: openssl rand -base64 32
AUTH_SECRET=""

# Em self-hosting/Docker, permite ao Auth.js confiar no Host encaminhado pelo proxy.
AUTH_TRUST_HOST="true"

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# URL do servidor Ollama da empresa (server-side only, não exposto ao cliente)
# OLLAMA_BASE_URL="http://ai.empresa.internal:11434"
