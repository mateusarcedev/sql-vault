# SQL Vault - Production Environment
# Copy to .env.production on the VPS. Never commit the real file.

# Public hostname. Use a real DNS name in production.
SQLVAULT_DOMAIN=sqlvault.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_USER=sqlvault
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=sqlvault

# Internal Docker connection. URL-encode special characters in the password.
DATABASE_URL=postgresql://sqlvault:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/sqlvault?schema=public

# Auth.js / application URL
NEXTAUTH_URL=https://sqlvault.example.com
AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TRUST_HOST=true

# 32 random bytes encoded as base64.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_ENCRYPTION_KEY=CHANGE_ME

# Optional server-side Ollama endpoint
OLLAMA_BASE_URL=

# Never enable demo data in production
ALLOW_DEMO_SEED=false
